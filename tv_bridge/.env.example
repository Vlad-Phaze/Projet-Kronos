# Cookies du compte TradingView. Le mot de passe ne sert pas.
# Chrome ou Edge : F12 → Application → Cookies → https://www.tradingview.com
#   sessionid      → TV_SESSION
#   sessionid_sign → TV_SIGNATURE
TV_SESSION=
TV_SIGNATURE=

# Optionnel. Si tu le renseignes, le bridge exige le même jeton
# dans l'en-tête Authorization, et Python le lit via TV_BRIDGE_TOKEN.
# TV_BRIDGE_TOKEN=
